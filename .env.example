# Docker Hub Configuration (for Jenkins/CI)
DOCKER_HUB_USERNAME=hsk09

# Backend Environment Variables
MONGODB_URL=mongodb://localhost:27017/mernai_chatbot
JWT_SECRET=your_secure_jwt_secret_here
COOKIE_SECRET=your_secure_cookie_secret_here

# OpenRouter API Configuration
OPEN_AI_SECRET=your_openrouter_api_key_here
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Set to 1 to disable fallback responses in production
OPEN_AI_STRICT=0

# Backend Port (default: 5000)
PORT=5000
