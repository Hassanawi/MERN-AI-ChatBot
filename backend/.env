# Example environment variables for local development
# Copy this file to .env and fill the values before running `npm run dev` or `npm start`

# MongoDB connection string
MONGODB_URL=mongodb://localhost:27017/mernai_chatbot

# JWT secret used by jsonwebtoken
JWT_SECRET=replace_with_a_strong_random_secret

# Cookie signing secret used by cookie-parser (for signed cookies)
COOKIE_SECRET=replace_with_another_secret

# Temporary OpenAI/OpenRouter API key (will be rotated by user)
OPEN_AI_SECRET=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

# OpenRouter settings (use OpenRouter free/community models)
# Base URL for OpenRouter (use api.openrouter.ai for API access, not /api/v1)
OPENROUTER_BASE=https://openrouter.ai/api/v1
# Try a model available to your key (updated to the AtlasCloud free model you reported)
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# When unset or 0, backend will return a local fallback response on provider errors (useful for dev)
OPEN_AI_STRICT=0
