# Example environment variables for local development
# Copy this file to .env and fill the values before running `npm run dev` or `npm start`

# MongoDB connection string
MONGODB_URL=mongodb://localhost:27017/mernai_chatbot

# JWT secret used by jsonwebtoken
JWT_SECRET=replace_with_a_strong_random_secret

# Cookie signing secret used by cookie-parser (for signed cookies)
COOKIE_SECRET=replace_with_another_secret

# OpenAI configuration
# Your OpenAI API key (required for chat completion). Example: OPEN_AI_SECRET=sk-...
OPEN_AI_SECRET=
# Optional organization id
OPENAI_ORAGANIZATION_ID=
